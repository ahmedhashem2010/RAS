# RAS — Supabase environment variables
# Copy this file to `.env.local` and fill in your project values.

# Public Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings > API > service_role). SERVER-ONLY.
# Used for super-admin user creation. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Base URL used in auth confirmation links.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
